{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES2019",
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": "..",
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": ["../lib/**/*.ts", "../code-execution-server/src/**/*.ts", "./**/*.ts"]
}
