# Copy to .env.local for local development, or .env.docker for compose.

# mock | production
APP_MODE=mock

# Postgres
DATABASE_URL=postgresql://daily_coding_challenge:daily_coding_challenge@localhost:5432/daily_coding_challenge

# Code execution server (Next.js → executor)
CODE_EXECUTION_URL=http://localhost:5000

# Code execution server itself: mock | docker
# mock runs JS/TS/Python in-process (no Docker required)
EXECUTION_MODE=mock

# OpenAI (ignored when APP_MODE=mock or MOCK_OPENAI=true)
OPENAI_API_KEY=
MOCK_OPENAI=true

# Clerk (dummy keys are fine in APP_MODE=mock)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_mockpublishablekey000000000000000
CLERK_SECRET_KEY=sk_test_mocksecretkey0000000000000000000
MOCK_CLERK_USER_ID=mock_clerk_user

NEXT_PUBLIC_APP_URL=http://localhost:3000
